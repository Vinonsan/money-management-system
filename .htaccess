# ──────────────────────────────────────────────────────────────────────────
# Project Root .htaccess — Security Fallback
# ──────────────────────────────────────────────────────────────────────────
# With the document root configured to /public/ in cPanel, Apache does
# not serve files above the document root for normal requests.
# This file is a defense-in-depth safety net only.
# Primary URL rewriting is handled by public/.htaccess.
# ──────────────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive directories
    RewriteRule ^config/ - [F,L]
    RewriteRule ^src/    - [F,L]
    RewriteRule ^deploy/ - [F,L]

    # Block access to Git metadata
    RewriteRule ^\.git - [F,L]

    # Block sensitive file types
    RewriteRule \.(sql|md|log|yml|env)$ - [F,L]
</IfModule>

# Disable directory listing
Options -Indexes

# Deny access to dot-files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
