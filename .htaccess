<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect direct .php access
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # Protect sensitive folders
    RewriteRule ^config(/|$) - [F,L]
    RewriteRule ^src(/|$) - [F,L]
    RewriteRule ^deploy(/|$) - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule \.(sql|md|log|yml|env)$ - [F,L]

    # Existing files/folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all requests to public
    RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]
</IfModule>

Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>