RewriteEngine On
RewriteBase /money-management-system-1/

# Redirect direct access to .php files to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Explicitly rewrite root requests to the front controller
RewriteRule ^$ public/index.php?route= [QSA,L]

# Block direct access to sensitive directories
RewriteRule ^config/ - [F,L]
RewriteRule ^src/    - [F,L]
RewriteRule ^deploy/ - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule \.(sql|md|log|yml|env)$ - [F,L]

# Serve existing files from /public/ directory (assets, uploads, etc.)
RewriteCond %{DOCUMENT_ROOT}/money-management-system-1/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/money-management-system-1/public/$1 -d
RewriteRule ^(.*)$ public/$1 [L]

# Front controller pattern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]

Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
