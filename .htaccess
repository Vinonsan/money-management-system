RewriteEngine On
RewriteBase /php-structure/

# Redirect direct access to .php files to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Explicitly rewrite root requests to the front controller
RewriteRule ^$ public/index.php?route= [QSA,L]

# Front controller pattern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]
