<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Check if the requested file/folder physically exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirect all clean URLs to index.php with ?route=
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>